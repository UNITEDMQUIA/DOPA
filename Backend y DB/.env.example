# Configuración de Base de Datos PostgreSQL (Docker / Local)
POSTGRES_USER=dopa_user
POSTGRES_PASSWORD=dopa_pass
POSTGRES_DB=dopa_db
POSTGRES_PORT=5432

# Cadena de conexión SQLAlchemy (psycopg v3 / PostgreSQL)
DATABASE_URL=postgresql+psycopg://dopa_user:dopa_pass@localhost:5432/dopa_db

# Configuración de pgAdmin 4
PGADMIN_DEFAULT_EMAIL=admin@dopa.app
PGADMIN_DEFAULT_PASSWORD=admin123

# Configuración de Seguridad JWT Stateless (RNF-06)
JWT_SECRET_KEY=dopa-super-secret-jwt-key-tdah-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
